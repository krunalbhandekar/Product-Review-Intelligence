# Product Review Intelligence — environment template.
#
# This file contains ONLY secrets and deployment-specific values.
# Static operational configs (model names, chunk sizes, retry counts,
# the lookback window, etc.) live in code at app/config/settings.py
# so they are version-controlled and code-reviewed.

# --- Secrets ----------------------------------------------------------
# Auth: the X-API-Key header callers must send.
API_KEY=dev-key
# Groq API key for summarisation.
GROQ_API_KEY=

# --- Deployment-specific identifiers ----------------------------------
# Target Google Doc ID (the segment between /d/ and /edit in the URL).
GOOGLE_DOC_ID=
# Recipient for the weekly pulse Gmail draft.
EMAIL_TO=
# External MCP server (Google Docs + Gmail).
MCP_SERVER_URL=https://google-docs-gmail-mcp-server-u06s.onrender.com
# App identifiers tracked by this deployment.
PLAYSTORE_APP_ID=
APPSTORE_APP_ID=
